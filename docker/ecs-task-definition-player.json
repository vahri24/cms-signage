{
  "family": "signage-player",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_EXECUTION_ROLE",
  "taskRoleArn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/REPLACE_TASK_ROLE",
  "containerDefinitions": [
    {
      "name": "signage-player",
      "image": "REPLACE_ACCOUNT_ID.dkr.ecr.REPLACE_REGION.amazonaws.com/localhost/common:signage-player",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "signage-media",
          "containerPath": "/var/www/html/media",
          "readOnly": true
        },
        {
          "sourceVolume": "signage-devices",
          "containerPath": "/var/www/html/devices",
          "readOnly": true
        },
        {
          "sourceVolume": "signage-heartbeats",
          "containerPath": "/var/www/html/heartbeats",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/signage-player",
          "awslogs-create-group": "true",
          "awslogs-region": "REPLACE_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "signage-media",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_EFS_FILE_SYSTEM_ID",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "REPLACE_EFS_ACCESS_POINT_ID",
          "iam": "DISABLED"
        }
      }
    },
    {
      "name": "signage-devices",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_EFS_FILE_SYSTEM_ID",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "REPLACE_EFS_DEVICES_ACCESS_POINT_ID",
          "iam": "DISABLED"
        }
      }
    },
    {
      "name": "signage-heartbeats",
      "efsVolumeConfiguration": {
        "fileSystemId": "REPLACE_EFS_FILE_SYSTEM_ID",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "REPLACE_EFS_HEARTBEATS_ACCESS_POINT_ID",
          "iam": "DISABLED"
        }
      }
    }
  ]
}
